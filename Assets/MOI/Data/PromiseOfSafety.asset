    glowFrom: 1.4
    glowTo: 1.4
  - id: city-responds
    title: A City That Responds
    start: 137
    end: 149
    direction: Buildings open protected connections, transit reroutes, and roads
      clear an emergency corridor around an affected area.
    voiceOverEn: "The city itself responds. Buildings open safe connections, transport
      changes course, and roads make way for responders\u2014adapting around people
      when they need it most."
    voiceOverAr: "\u0648\u062A\u0633\u062A\u062C\u064A\u0628 \u0627\u0644\u0645\u062F\u064A\u0646\u0629
      \u0646\u0641\u0633\u0647\u0627. \u062A\u0641\u062A\u062D \u0627\u0644\u0645\u0628\u0627\u0646\u064A
      \u0645\u0645\u0631\u0627\u062A \u0622\u0645\u0646\u0629\u060C \u0648\u062A\u062A\u063A\u064A\u0651\u0631
      \u0645\u0633\u0627\u0631\u0627\u062A \u0627\u0644\u0646\u0642\u0644\u060C \u0648\u062A\u0641\u0633\u062D
      \u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0645\u062C\u0627\u0644 \u0644\u0641\u0631\u0642
      \u0627\u0644\u0637\u0648\u0627\u0631\u0626\u2026 \u0644\u062A\u062A\u0643\u064A\u0651\u0641
      \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0645\u0639 \u0627\u062D\u062A\u064A\u0627\u062C\u0627\u062A
      \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0648\u0642\u062A \u0627\u0644\u062D\u0627\u062C\u0629"
    voiceClipEn: {fileID: 0}
    voiceClipAr: {fileID: 0}
    environmentId: previs_14
    transitionIn: 1
    transitionDuration: 1.2
